# Kala - environment for the Docker Compose stack (docker-compose.yml)
#
#   cp .env.example .env
#
# Then replace every value marked CHANGE_ME. The real .env is git-ignored - never commit it.
# `docker compose` reads it automatically. (Local development uses server/.env instead;
# see server/.env.example.)

# --- PostgreSQL --------------------------------------------------------------
# Used to create the database on the FIRST start and by the backend to connect to it.
# The password is also embedded in the DATABASE_URL below, so keep it URL-safe:
# letters and digits only, e.g. generate one with:  openssl rand -hex 24
# NOTE: PostgreSQL only reads these when the data volume is first created. Changing the
# password later does not change it inside an existing database (see README).
POSTGRES_DB=kala
POSTGRES_USER=kala
POSTGRES_PASSWORD=CHANGE_ME

# --- Prisma / backend database connection --------------------------------------
# DATABASE_URL is assembled for you in docker-compose.yml from the values above:
#
#   postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB?schema=public
#
# "postgres" is the compose service name on the private Docker network - PostgreSQL is
# not published to the host. Prisma migrations are applied automatically on backend start
# with `prisma migrate deploy`.

# --- Backend -------------------------------------------------------------------
# Secret used to sign session cookies. REQUIRED - the backend refuses to start in
# production without it. Use a long random value:  openssl rand -hex 32
# Changing it signs every user out.
SESSION_SECRET=CHANGE_ME

# Set to true when Kala is served over HTTPS (e.g. behind a TLS-terminating reverse proxy
# that sends X-Forwarded-Proto: https). Session cookies are then marked Secure and will
# NOT work over plain HTTP. Leave false for http://localhost.
COOKIE_SECURE=false

# NODE_ENV=production and PORT=3001 are set by docker-compose.yml.
# Real-time collaboration (Server-Sent Events) needs no extra configuration: it is served
# by the same backend under /api/realtime and proxied by nginx.

# --- Transactional email (Resend) ----------------------------------------------
# Board invitation emails are sent with Resend (https://resend.com). The API key
# is only read by the backend container and never exposed to the browser.
# Before it works, add and verify the sending domain in Resend - see the
# "Transactional email" section of the README for the required DNS records.
# Generate an API key in Resend and paste it here. Never commit the real value.
RESEND_API_KEY=
# Verified sender on your domain. For production use the Kala domain - never
# onboarding@resend.dev.
EMAIL_FROM="Kala <noreply@kala.studiovanderheide.nl>"
# Public URL of the app, used for the invitation accept link in emails.
APP_URL="https://kala.studiovanderheide.nl"

# --- Kala AI (optional) --------------------------------------------------------
# Kala AI is a read-only assistant that answers questions about the current board. The browser
# never talks to an AI provider and never sees a key - only the backend does. When someone uses
# Kala AI, the content of that board (titles, descriptions, due dates, priorities, labels,
# checklists, recent activity) is sent to the provider they are using.
#
# Each user picks a provider and model in Settings -> Kala AI and can paste THEIR OWN API key
# there (stored encrypted, never shown again). Everything below is optional and only sets up
# what the server offers by default. Kala AI works for a user if they saved a key of their own
# or the server has a key for the provider they chose.
#
# Providers: anthropic (native API) and the OpenAI-compatible ones: openai, openrouter, google
# (Gemini), edenai - plus one custom OpenAI-compatible endpoint. Users cannot enter URLs.
#
# Server-side (shared) keys - add only the providers you want to offer without users' own keys.
# The names are AI_-prefixed on purpose: Kala never reads ANTHROPIC_API_KEY, OPENAI_API_KEY, etc.,
# which may belong to other tools on the same machine.
AI_ANTHROPIC_API_KEY=
AI_OPENAI_API_KEY=
AI_OPENROUTER_API_KEY=
AI_GOOGLE_API_KEY=
AI_EDENAI_API_KEY=
#
# Optional custom OpenAI-compatible endpoint (a self-hosted gateway, LiteLLM, Ollama, ...).
# Only the administrator can set the URL. It appears in Settings under AI_CUSTOM_LABEL.
AI_CUSTOM_BASE_URL=
AI_CUSTOM_API_KEY=
AI_CUSTOM_LABEL=
#
# Server default, used by people who have not chosen anything in Settings. Leave AI_PROVIDER empty
# to use the first provider above that has a key. AI_MODEL defaults to the provider's suggestion
# (claude-opus-5, gpt-5, google/gemini-2.5-flash, ...); claude-sonnet-5 is a cheaper choice.
AI_PROVIDER=
AI_MODEL=
# Optional (anthropic default only): reasoning effort low | medium | high | xhigh | max.
# Only for models that support it (Claude Opus/Sonnet 4.6 and newer); leave empty otherwise.
AI_EFFORT=
# Optional: requests one user may make per hour when using a SERVER key (default 60). People using
# their own key are not limited.
AI_MAX_REQUESTS_PER_HOUR=60
# Optional: the secret that encrypts users' own API keys in the database. Defaults to
# SESSION_SECRET. Changing either one makes saved keys unreadable (users enter them again).
AI_KEY_ENCRYPTION_SECRET=
# Legacy shorthand, still supported: AI_API_KEY / AI_BASE_URL apply to AI_PROVIDER (default anthropic).

# --- External integrations (optional) ------------------------------------------
# Kala's generic integration API (/api/integrations) lets an external system such as
# DocArchitect create, update and track Kala cards with an API key. Nothing here is
# required: without any INTEGRATION_* variable Kala has no integrations and works as
# always. A provider is a lower-case slug; its settings are INTEGRATION_<PROVIDER>_*.
# The same variables are read by the backend container only.
#
# Enable the DocArchitect integration (provider slug "docarchitect"):
# INTEGRATION_DOCARCHITECT_ENABLED=true
# Display name shown next to externally created cards (defaults to "Docarchitect"):
# INTEGRATION_DOCARCHITECT_LABEL=DocArchitect
# Base URL of the external system - informational, never hardcoded or called by Kala:
# INTEGRATION_DOCARCHITECT_BASE_URL=https://docarchitect.example.com
# Default placement when an incoming card omits board_id/list_id (ids from the
# discovery endpoints; without either, creates answer 422 instead of guessing):
# INTEGRATION_DOCARCHITECT_DEFAULT_BOARD_ID=
# INTEGRATION_DOCARCHITECT_DEFAULT_LIST_ID=
# Outbound webhook target. Empty = no webhooks for this provider.
# INTEGRATION_DOCARCHITECT_WEBHOOK_URL=https://docarchitect.example.com/hooks/kala
# Shared secret used to sign deliveries (X-Kala-Signature: sha256=HMAC over
# "${timestamp}.${body}"). Empty = deliveries are unsigned.
# INTEGRATION_DOCARCHITECT_WEBHOOK_SECRET=
# Comma-separated subscription; defaults to every event when empty:
# INTEGRATION_DOCARCHITECT_WEBHOOK_EVENTS=card.created,card.updated,card.moved,card.completed,card.archived
#
# Status mapping: normalized statuses (todo, in_progress, completed, cancelled) come
# from card list titles. Override exact titles with a JSON map when your board names
# differ from the built-in patterns:
# INTEGRATION_STATUS_MAP={"Triaging":"todo","Building":"in_progress","Shipped":"completed"}
# Requests per integration API key per hour before 429 (default 600):
# INTEGRATION_RATE_LIMIT_PER_HOUR=600


# --- Frontend / public access --------------------------------------------------
# Host port on which Kala is published (the only port exposed by the stack).
KALA_PORT=8080

# Interface the port is published on. 0.0.0.0 = reachable from the network (fine for a
# quick test). Use 127.0.0.1 when a reverse proxy on the same server (Plesk, Caddy, ...)
# provides the public HTTPS endpoint, so plain HTTP is never exposed to the internet.
KALA_BIND_ADDRESS=0.0.0.0

# Public URL users open in the browser. The frontend and API share this one origin, so
# this is only used for the backend's CORS allow-list. Use your https:// domain in production.
KALA_PUBLIC_URL=http://localhost:8080

# The frontend is built with VITE_API_URL=/api (same origin, proxied by nginx). That is set
# in docker-compose.yml, not here.
