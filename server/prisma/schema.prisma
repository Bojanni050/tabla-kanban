generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaces       Workspace[]
  boardMemberships BoardMember[]
  sentInvitations  Invitation[]
  aiSettings       UserAiSettings?
  aiKeys           UserAiKey[]
  assignedCards    Card[]           @relation("CardAssignee")
  cardActivities   CardActivity[]
  boardActivities  BoardActivity[]
  integrationKeys  IntegrationKey[]
}

// Kala AI: which provider and model a user chose in Settings (one row per user).
model UserAiSettings {
  userId    String   @id
  provider  String
  model     String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A user's own API key for one AI provider. Only ever stored encrypted (AES-256-GCM); the
// plaintext key is never returned by the API. keyLast4 is a display hint ("...abcd").
model UserAiKey {
  id            String   @id @default(uuid())
  userId        String
  provider      String
  keyCiphertext String
  keyLast4      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// A machine credential for the integration API (external systems such as DocArchitect).
// Only the SHA-256 hash of the token is stored: the plaintext is shown once at creation
// and never again. Requests made with a key act as `user`, so the normal BoardMember
// role rules apply - there is no separate integration permission system. Revoking sets
// revokedAt; the token then stops working immediately.
model IntegrationKey {
  id          String    @id @default(uuid())
  name        String
  provider    String
  userId      String
  tokenHash   String    @unique
  tokenPrefix String
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}

// The identity of a Kala card in an external system (a DocArchitect Action today, other
// providers later). Optional: normal cards have no external reference. provider +
// externalId uniquely identifies the originating work item, so a retried create request
// from the external system can never produce a duplicate card.
model ExternalReference {
  id          String   @id @default(uuid())
  cardId      String
  provider    String
  externalId  String
  externalUrl String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([cardId])
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  boards Board[]
}

model Board {
  id          String   @id @default(uuid())
  name        String
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lists       List[]
  labels      Label[]
  members     BoardMember[]
  invitations Invitation[]
  activities  BoardActivity[]
  swimlanes   Swimlane[]
  cardTypes   CardType[]
}

enum BoardRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// A user's membership of a board. Exactly one member per board has the OWNER role.
model BoardMember {
  id        String    @id @default(uuid())
  boardId   String
  userId    String
  role      BoardRole
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

// An invitation to join a board. The email is stored lower-cased. An invitation is
// single-use: it is pending until acceptedAt or declinedAt is set, or expiresAt passes.
model Invitation {
  id          String    @id @default(uuid())
  boardId     String
  email       String
  invitedById String
  role        BoardRole
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  declinedAt  DateTime?
  createdAt   DateTime  @default(now())

  board     Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  invitedBy User  @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([email])
}

model List {
  id        String   @id @default(uuid())
  title     String
  position  Float
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// A horizontal row grouping cards across lists (Swimlanes v1). Optional: cards
// without a swimlaneId stay visible in the "Unassigned" row.
model Swimlane {
  id        String   @id @default(uuid())
  name      String
  position  Float
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId, position])
}

// A board-level type describing what a card IS (e.g. Task, Feature, Bug).
// Strictly separate from labels: a card has at most one optional type.
model CardType {
  id        String   @id @default(uuid())
  name      String
  color     String
  position  Float
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId, position])
}

model Label {
  id        String   @id @default(uuid())
  name      String
  color     String
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId])
}

model ChecklistItem {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  position  Float
  cardId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, position])
}

model Card {
  id          String    @id @default(uuid())
  title       String
  description String?
  position    Float
  listId      String
  priority    Priority?
  dueDate     DateTime?
  archived    Boolean   @default(false)
  assigneeId  String?
  swimlaneId  String?
  cardTypeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  list               List                @relation(fields: [listId], references: [id], onDelete: Cascade)
  swimlane           Swimlane?           @relation(fields: [swimlaneId], references: [id], onDelete: SetNull)
  cardType           CardType?           @relation(fields: [cardTypeId], references: [id], onDelete: SetNull)
  labels             Label[]
  checklistItems     ChecklistItem[]
  assignee           User?               @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  activities         CardActivity[]
  externalReferences ExternalReference[]

  @@index([listId, position])
  @@index([archived])
  @@index([assigneeId])
  @@index([swimlaneId])
  @@index([cardTypeId])
}

// One row per board-level change worth surfacing (e.g. team changes).
model BoardActivity {
  id        String   @id @default(uuid())
  boardId   String
  actorId   String?
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
}

// One row per card change worth surfacing in the card's activity history.
// metadata holds display-ready details (e.g. assigneeId and assigneeName).
model CardActivity {
  id        String   @id @default(uuid())
  cardId    String
  actorId   String?
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([cardId, createdAt])
}
