# Kala backend - LOCAL DEVELOPMENT environment.
#
#   cd server && cp .env.example .env
#
# For Docker deployment use the .env.example in the repository root instead.

# PostgreSQL started with `docker compose -f docker-compose.dev.yml up -d`
# (or any PostgreSQL you run locally).
DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban?schema=public"

PORT=3001

# Allowed browser origin of the Vite dev server.
CORS_ORIGIN="http://localhost:5173"

# Optional in development (a built-in dev value is used if unset). REQUIRED in production.
# SESSION_SECRET="use-a-long-random-value"

# Kala AI (optional). See the root .env.example for everything. Users can also add their own
# key in Settings -> Kala AI, so none of this is required.
# AI_ANTHROPIC_API_KEY=
# AI_OPENROUTER_API_KEY=
# AI_GOOGLE_API_KEY=
# AI_PROVIDER=
# AI_MODEL=

# Set to true only when serving over HTTPS.
# COOKIE_SECURE=false

# --- Transactional email (Resend) --------------------------------------------
# Board invitation emails are sent with Resend. The API key is ONLY read by the
# backend and must never appear in frontend code or Git.
# Get a key at https://resend.com (the sender domain must be verified there first).
# RESEND_API_KEY=
# EMAIL_FROM="Kala <noreply@kala.studiovanderheide.nl>"
# APP_URL="https://kala.studiovanderheide.nl"
