# Kala backend - LOCAL DEVELOPMENT environment.
#
#   cd server && cp .env.example .env
#
# For Docker deployment use the .env.example in the repository root instead.

# PostgreSQL started with `docker compose -f docker-compose.dev.yml up -d`
# (or any PostgreSQL you run locally).
DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban?schema=public"

PORT=3001

# Allowed browser origin of the Vite dev server.
CORS_ORIGIN="http://localhost:5173"

# Optional in development (a built-in dev value is used if unset). REQUIRED in production.
# SESSION_SECRET="use-a-long-random-value"

# Kala AI (optional; off until AI_API_KEY is set). See the root .env.example for details.
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5
# AI_API_KEY=
# AI_BASE_URL=
# AI_EFFORT=
# AI_MAX_REQUESTS_PER_HOUR=60

# Set to true only when serving over HTTPS.
# COOKIE_SECURE=false
